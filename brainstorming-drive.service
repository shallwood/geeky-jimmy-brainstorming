[Unit]
Description=Mount brainstorming backups from Google Drive
After=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount "gdrive:Brainstorming Backups" /mnt/gdrive --allow-other --vfs-cache-mode writes --vfs-write-back 1s
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
